{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Android Remote",
  "version": "0.1.0",
  "identifier": "io.enginefuture.androidremote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Android Remote",
        "width": 430,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 30
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}